# API-only MoneyPrinterTurbo engine runtime
# Copy to .env.engine and replace placeholders. Never commit real secrets.

# Required unless MPT_ALLOW_INSECURE=1 (local trusted development only).
MPT_API_KEY=replace-with-a-long-random-secret

# Internal container listener.
MPT_LISTEN_HOST=0.0.0.0
MPT_LISTEN_PORT=8080

# Browser CORS is not needed when your app backend calls this service server-to-server.
# If a browser must call the engine directly, list exact trusted origins separated by commas.
CORS_ALLOWED_ORIGINS=

# Keep this disabled outside a trusted local machine.
MPT_ALLOW_INSECURE=0

# Existing upstream Redis host override; useful when enable_redis=true in config.toml.
MPT_APP_REDIS_HOST=redis
